# FARM-1.9: agent-farm state hygiene
*.db
state/*.bak-*
state/*.sqlite*
state/logs/
results/*/

# Worktrees (in case anyone clones inside)
worktrees/

# Environment files (keep .env.example tracked)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / OS
.~lock.*
.DS_Store
.idea/
.vscode/
*.swp

# Virtual environments
.venv/
venv/

# Logs
*.log

# Terraform
infra/terraform/github/.terraform/
infra/terraform/github/terraform.tfstate
infra/terraform/github/terraform.tfstate.backup
infra/terraform/github/.terraform.lock.hcl

# Runtime state written by the watchdog and deploy-keeper. Versioning it would make
# every agent's local run appear as a change; leaving it untracked buried the files
# that did need a decision.
results/
state/deploy-keeper-triggers/
state/deploy_keeper_*_count
state/stack-owner.json
state/stack-owner.json.lock

# Per-machine coordination identity and capabilities. Committing either would
# make one machine's answer the other's: the desktop publishes a graphics card
# it has and the laptop does not, and a shared name would have both claiming as
# the same machine, which is the one thing the ledger cannot detect.
state/coord-machine
state/coord-capabilities
state/coord-keeper/
state/thesis_pdf_published.sha
