# PLANTILLA del entorno de la granja. Copiar a farm.env y ajustar THESIS_ROOT.
# de agent-farm; ningun script lo carga solo.
#
# NO esta versionado, y se perdio en el borrado del 2026-09-14. Reescrito el
# 2026-09-15. Sin el, TODO script de scripts/ cae a su valor por defecto
# `$HOME/Thesis2/agent-farm` -- una ruta que en esta maquina no existe, porque el
# directorio de trabajo aqui es Thesis-laptop y no Thesis2. El fallo no es ruidoso:
# un script que resuelve a un directorio inexistente se queda sin encontrar nada
# y sigue.
#
#   source ~/Thesis-laptop/agent-farm/farm.env

export THESIS_ROOT="$HOME/Thesis2"
export AGENT_FARM_ROOT="$THESIS_ROOT/agent-farm"
export PROTEA_REPO="$THESIS_ROOT/PROTEA"

# DEPLOY es el arbol que los workers CARGAN, y el guardia de revision lo compara
# contra la declaracion. En esta maquina coincide con PROTEA_REPO -- el clon de
# trabajo y la ranura de despliegue son el mismo directorio -- lo que significa
# que un `git checkout` aqui mueve el arbol de despliegue. Las unidades de
# systemd lo fijan por su cuenta (protea-worker@.service:36), asi que esta linea
# es para los scripts, no para ellas.
export DEPLOY="$THESIS_ROOT/PROTEA"
