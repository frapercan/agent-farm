# agent-farm path overrides for the LAPTOP layout (~/Thesis-laptop instead of ~/Thesis2).
# The farm scripts default their roots to ~/Thesis2/...; source this to point them here.
#   set -a && source ~/Thesis-laptop/agent-farm/farm.env && set +a
export THESIS_ROOT="$HOME/Thesis-laptop"
export AGENT_FARM_ROOT="$HOME/Thesis-laptop/agent-farm"
export PROTEA_REPO="$HOME/Thesis-laptop/PROTEA"
export TRIGGER_PROTEA_REPO="$HOME/Thesis-laptop/PROTEA"
# Reuse-in-place: run the platform directly from the main repo, no separate
# deploy worktree / second GPU venv. deploy-keeper honours PROTEA_REPO above.
export DEPLOY="$HOME/Thesis-laptop/PROTEA"

# The coordination checkout. coord-send.sh and coord-fence.sh default this to
# ~/Thesis2/farm-coord, which does not exist on this machine, so a send without
# it fails or writes nowhere.
export FARM_COORD_ROOT="$HOME/Thesis-laptop/farm-coord"
export COORD_MACHINE="laptop"
