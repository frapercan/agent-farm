[Unit]
Description=PROTEA compute-node worker for queue %i
Documentation=https://github.com/frapercan/agent-farm/blob/main/scripts/services/README-lab-worker.md
# No ordering directives here, and adding one would be worse than nothing. This
# is a USER unit, and a user manager cannot order against a system target: on
# this machine `systemctl --user show time-sync.target -p LoadState` reports
# not-found, and so did the `After=network-online.target` and
# `Wants=network-online.target` that used to sit on these two lines. They read
# as gates for as long as they existed and ordered against nothing, which is why
# the worker could start before the network was up and before the clock had been
# set. They are gone rather than commented, because an inert declaration is
# worse than no declaration.
#
# `systemctl --user show <unit> -p After` is not a check on any of this: it
# lists ordering names even for units that do not exist, so it reports what was
# asked for rather than what will happen.
#
# The clock gate is real and it is in the wrapper, which is the process that
# stamps the events. It waits on timedatectl before the worker consumes
# anything, and it starts the worker anyway if the clock never synchronises,
# because a queue with no consumer costs more than a wrong timestamp. The worker
# does not need a network ordering either: it retries every thirty seconds for
# as long as the server is unreachable, which is what StartLimitIntervalSec=0
# below is for. See "The clock gate" in the README.
# The persistent server can be unreachable for hours, either because it is
# closed or because the link is down. That is not a reason to give up, so the
# start rate limiter is disabled and the unit retries for as long as it takes.
StartLimitIntervalSec=0

[Service]
Type=simple
# %h rather than a literal home directory: a hardcoded path is what broke
# every other unit and script in this project when the username changed.
#
# The wrapper is INSTALLED to a stable path rather than run out of the
# checkout, so that a worktree, a branch switch or a rebase cannot stop a
# running node. The repository stays the source; see the README for the one
# command that reinstalls it after a pull.
ExecStart=/bin/bash %h/.local/lib/protea/protea-lab-worker.sh %i
# The deploy slot, never the developer workspace. Set explicitly as well as in
# the wrapper's default, so the two cannot drift apart again: until 2026-09-02
# the unit pointed here at repositories/PROTEA while protea-node-sync.sh
# maintained worktrees/protea-deploy, and the worker ran a tree the guard was
# not looking at.
Environment=PROTEA_REPO=%h/Thesis2/worktrees/protea-deploy
WorkingDirectory=%h/Thesis2/worktrees/protea-deploy

Restart=always
RestartSec=30

# A configuration error is not worth retrying thirty seconds at a time, so the
# wrapper exits 78 for those and the unit stops instead of looping.
RestartPreventExitStatus=78

# Kept as a file as well as in the journal, because the throughput analysis
# reads per-batch timings out of it. The journal alone would be enough for
# operating the node; the file is what makes the run measurable afterwards.
StandardOutput=append:%h/Thesis2/storage/logs/protea-lab-worker-%i.log
StandardError=inherit

# Give an in-flight batch time to finish before the process is killed. An
# unacknowledged batch is redelivered by the broker rather than lost, so this
# only saves duplicated compute.
TimeoutStopSec=120
KillSignal=SIGINT

[Install]
WantedBy=default.target
